# Vercel / npm compatibility for this CRA scaffold.
#
# `react-day-picker@8` declares a peer dep of `date-fns@^2 || ^3`, but this
# scaffold ships `date-fns@4`. Yarn 1 tolerates the mismatch; npm 7+ does
# not, and by default Vercel uses npm. Setting this flag makes both
# managers accept the resolution.
legacy-peer-deps=true
